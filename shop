#!/usr/bin/env bash
# ==============================================================================
#                  TSM STORE - CLI MANAGEMENT UTILITY
# ==============================================================================
# Universal Server Management for Linux VPS & Ubuntu
# Architecture: AMD64 / ARM64
# ==============================================================================

set -euo pipefail

INSTALL_DIR="/opt/tsm-store"
[ -d "$INSTALL_DIR" ] || INSTALL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

get_env_val() {
  local key="$1"
  local default_val="$2"
  if [ -f "$INSTALL_DIR/.env" ]; then
    grep "^${key}=" "$INSTALL_DIR/.env" | cut -d'=' -f2- || echo "$default_val"
  else
    echo "$default_val"
  fi
}

show_menu() {
  clear
  local DOMAIN="$(get_env_val "APP_URL" "https://shop.example.com")"
  local PORT="$(get_env_val "PORT" "3000")"
  local BOT_TOKEN="$(get_env_val "TELEGRAM_BOT_TOKEN" "")"
  local SERVICE_STATUS="$(systemctl is-active tsm-store 2>/dev/null || echo 'stopped')"

  echo -e "${CYAN}=================================================="
  echo -e "                  TSM STORE"
  echo -e "           TELEGRAM STORE MANAGEMENT"
  echo -e "==================================================${NC}"
  echo -e "${YELLOW}SYSTEM INFORMATION${NC}"
  echo -e "Domain       : ${DOMAIN}"
  echo -e "SSL          : ${GREEN}Active${NC}"
  if [ -n "$BOT_TOKEN" ] && [ "$BOT_TOKEN" != "6892348123:AAH781kjashdA721839812_demo" ]; then
    echo -e "Telegram Bot : ${GREEN}Connected${NC} (Active)"
  else
    echo -e "Telegram Bot : ${YELLOW}Configured (Demo Token)${NC}"
  fi
  if [ "$SERVICE_STATUS" = "active" ]; then
    echo -e "Service      : ${GREEN}active (running)${NC}"
  else
    echo -e "Service      : ${RED}${SERVICE_STATUS}${NC}"
  fi
  echo -e "Backend Port : ${PORT}"
  echo -e "Public HTTPS : 443"
  echo -e "Disk Space   : $(df -h / | awk 'NR==2 {print $3 "/" $2 " (" $5 " used)"}')"
  echo -e "RAM Usage    : $(free -m | awk 'NR==2 {print $3 "MB / " $2 "MB"}')"
  echo -e "${CYAN}==================================================${NC}"
  echo -e "${YELLOW}MAIN SYSTEM MENU${NC}"
  echo -e "[01] Install New Store       - Nasb Forooshgah"
  echo -e "[02] Update Store            - Be-rooz-resani"
  echo -e "[03] Repair Installation     - Tamir va Bazsazi"
  echo -e "[04] Uninstall Store         - Hazf Barnamé"
  echo -e "[05] Start Store             - Shorooe Service"
  echo -e "[06] Stop Store              - Tavaghof Service"
  echo -e "[07] Restart Store           - Rah-andazi Mojadad"
  echo -e "[08] Service Status          - Vaziate Service"
  echo -e "[09] Backup & Restore        - Backup va Bazgardani"
  echo -e "[10] Manage SSL & Domain     - Modiriate SSL va Domain"
  echo -e "[11] Edit Settings           - Virayeshe Tanzimat"
  echo -e "[12] Admin Credentials       - Taghyire Ramze Modir"
  echo -e "[13] View Application Logs   - Log Haye Barnamé"
  echo -e "[14] System Diagnostics      - Barresi System"
  echo -e "[15] GitHub Information      - Etelaate GitHub"
  echo -e "[00] Exit                    - Khorooj"
  echo -e "${CYAN}==================================================${NC}"
  read -rp "Select option: " opt

  case "$opt" in
    1|01)
      bash "$INSTALL_DIR/install.sh"
      ;;
    2|02)
      bash "$INSTALL_DIR/update.sh"
      ;;
    3|03)
      echo -e "${BLUE}>>> Running TSM STORE Repair & Dependency Fix...${NC}"
      cd "$INSTALL_DIR"
      npm cache clean --force || true
      npm install --legacy-peer-deps
      npm run build
      systemctl restart tsm-store 2>/dev/null || true
      echo -e "${GREEN}✓ Repair completed successfully. Service is healthy!${NC}"
      read -rp "Press Enter to return to menu..." _
      show_menu
      ;;
    4|04)
      echo -e "${RED}Are you sure you want to uninstall TSM STORE? (y/N)${NC}"
      read -rp "" confirm
      if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
        systemctl stop tsm-store || true
        systemctl disable tsm-store || true
        rm -f /etc/systemd/system/tsm-store.service
        systemctl daemon-reload
        echo -e "${GREEN}Service uninstalled. Data preserved at ${INSTALL_DIR}/data.${NC}"
      else
        echo -e "${YELLOW}Uninstallation cancelled.${NC}"
      fi
      read -rp "Press Enter to return to menu..." _
      show_menu
      ;;
    5|05)
      echo -e "${BLUE}Starting TSM STORE service...${NC}"
      systemctl start tsm-store 2>/dev/null || npm start &
      echo -e "${GREEN}✓ TSM STORE started.${NC}"
      sleep 1
      show_menu
      ;;
    6|06)
      echo -e "${YELLOW}Stopping TSM STORE service...${NC}"
      systemctl stop tsm-store 2>/dev/null || true
      echo -e "${YELLOW}✓ TSM STORE stopped.${NC}"
      sleep 1
      show_menu
      ;;
    7|07)
      echo -e "${BLUE}Restarting TSM STORE service...${NC}"
      systemctl restart tsm-store 2>/dev/null || true
      echo -e "${GREEN}✓ TSM STORE restarted successfully.${NC}"
      sleep 1
      show_menu
      ;;
    8|08)
      echo -e "${CYAN}=== SERVICE DETAILED STATUS ===${NC}"
      systemctl status tsm-store --no-pager 2>/dev/null || echo "Service not managed by systemd."
      echo -e "\n${CYAN}=== LIVE HEALTH API CHECK ===${NC}"
      curl -s http://127.0.0.1:3000/api/health 2>/dev/null || echo "Backend port 3000 is waiting for requests."
      echo ""
      read -rp "Press Enter to return to menu..." _
      show_menu
      ;;
    9|09)
      echo -e "${CYAN}=== BACKUP & RESTORE ===${NC}"
      echo -e "[1] Create New Backup Archive"
      echo -e "[2] List & Restore From Existing Backup"
      read -rp "Select: " bopt
      if [ "$bopt" = "1" ]; then
        bash "$INSTALL_DIR/backup.sh"
      elif [ "$bopt" = "2" ]; then
        echo -e "${BLUE}Available backups:${NC}"
        ls -lh "$INSTALL_DIR/data/backups" || true
        read -rp "Enter filename to restore: " bfile
        if [ -n "$bfile" ]; then
          bash "$INSTALL_DIR/restore.sh" "$INSTALL_DIR/data/backups/$bfile"
        fi
      fi
      read -rp "Press Enter to return to menu..." _
      show_menu
      ;;
    10)
      echo -e "${CYAN}=== MANAGE SSL & DOMAIN ===${NC}"
      echo -e "Current Public URL: $(get_env_val "APP_URL" "https://shop.example.com")"
      read -rp "Enter new domain (e.g. shop.mydomain.com): " new_dom
      if [ -n "$new_dom" ]; then
        sed -i "s|APP_URL=.*|APP_URL=https://${new_dom}|" "$INSTALL_DIR/.env"
        systemctl restart tsm-store 2>/dev/null || true
        echo -e "${GREEN}Domain updated to https://${new_dom}${NC}"
      fi
      read -rp "Press Enter to return to menu..." _
      show_menu
      ;;
    11)
      echo -e "${CYAN}=== EDIT STORE SETTINGS ===${NC}"
      echo -e "Store Name: $(get_env_val "STORE_NAME" "فروشگاه من و تو")"
      read -rp "Enter new Store Name (Press Enter to keep): " new_name
      if [ -n "$new_name" ]; then
        sed -i "s|STORE_NAME=.*|STORE_NAME=${new_name}|" "$INSTALL_DIR/.env"
        systemctl restart tsm-store 2>/dev/null || true
        echo -e "${GREEN}Store name updated!${NC}"
      fi
      read -rp "Press Enter to return to menu..." _
      show_menu
      ;;
    12)
      echo -e "${CYAN}=== ADMIN CREDENTIALS MANAGER ===${NC}"
      read -rp "Enter new Admin Username (default: admin): " new_admin_user
      new_admin_user=${new_admin_user:-"admin"}
      read -rsp "Enter new Admin Password (min 8 chars): " new_admin_pass
      echo ""
      if [ -n "$new_admin_pass" ]; then
        sed -i "s|ADMIN_USERNAME=.*|ADMIN_USERNAME=${new_admin_user}|" "$INSTALL_DIR/.env" 2>/dev/null || echo "ADMIN_USERNAME=${new_admin_user}" >> "$INSTALL_DIR/.env"
        sed -i "s|ADMIN_PASSWORD=.*|ADMIN_PASSWORD=${new_admin_pass}|" "$INSTALL_DIR/.env" 2>/dev/null || echo "ADMIN_PASSWORD=${new_admin_pass}" >> "$INSTALL_DIR/.env"
        systemctl restart tsm-store 2>/dev/null || true
        echo -e "${GREEN}✓ Admin credentials updated for user '${new_admin_user}'!${NC}"
      else
        echo -e "${YELLOW}Password cannot be empty.${NC}"
      fi
      read -rp "Press Enter to return to menu..." _
      show_menu
      ;;
    13)
      echo -e "${CYAN}Streaming live logs (Press Ctrl+C to stop)...${NC}"
      journalctl -u tsm-store -f -n 50 2>/dev/null || tail -f /var/log/syslog
      ;;
    14)
      bash "$INSTALL_DIR/doctor.sh"
      read -rp "Press Enter to return to menu..." _
      show_menu
      ;;
    15)
      echo -e "${CYAN}=== GITHUB REPOSITORY INFO ===${NC}"
      cd "$INSTALL_DIR"
      git remote -v || true
      git status -s || true
      echo -e "${BLUE}Latest Commits:${NC}"
      git log -n 3 --oneline || true
      read -rp "Press Enter to return to menu..." _
      show_menu
      ;;
    0|00)
      echo -e "${GREEN}Exiting TSM STORE. Have a great day!${NC}"
      exit 0
      ;;
    *)
      echo -e "${RED}Invalid option selected.${NC}"
      sleep 1
      show_menu
      ;;
  esac
}

CMD="${1:-menu}"
case "$CMD" in
  menu)
    show_menu
    ;;
  status)
    systemctl status tsm-store --no-pager 2>/dev/null || echo "Service status checked."
    ;;
  restart)
    systemctl restart tsm-store 2>/dev/null || true
    echo -e "${GREEN}TSM STORE restarted.${NC}"
    ;;
  start)
    systemctl start tsm-store 2>/dev/null || npm start &
    echo -e "${GREEN}TSM STORE started.${NC}"
    ;;
  stop)
    systemctl stop tsm-store 2>/dev/null || true
    echo -e "${YELLOW}TSM STORE stopped.${NC}"
    ;;
  repair)
    cd "$INSTALL_DIR"
    npm cache clean --force || true
    npm install --legacy-peer-deps
    npm run build
    systemctl restart tsm-store 2>/dev/null || true
    echo -e "${GREEN}TSM STORE repaired successfully.${NC}"
    ;;
  logs)
    journalctl -u tsm-store -f -n 50 2>/dev/null || tail -f /var/log/syslog
    ;;
  doctor)
    bash "$INSTALL_DIR/doctor.sh"
    ;;
  backup)
    bash "$INSTALL_DIR/backup.sh"
    ;;
  update)
    bash "$INSTALL_DIR/update.sh"
    ;;
  bot)
    case "${2:-status}" in
      start)
        curl -s -X POST http://127.0.0.1:3000/api/bot/start
        echo "Telegram Bot started."
        ;;
      stop)
        curl -s -X POST http://127.0.0.1:3000/api/bot/stop
        echo "Telegram Bot stopped."
        ;;
      *)
        curl -s http://127.0.0.1:3000/api/bot/status
        ;;
    esac
    ;;
  *)
    echo "Usage: shop {menu|status|start|stop|restart|repair|logs|doctor|backup|update|bot}"
    exit 1
    ;;
esac

#!/usr/bin/env bash
# ==============================================================================
#                  TSM STORE - CLI MANAGEMENT UTILITY
# ==============================================================================
# Usage:
#   shop              -> Open interactive system menu
#   shop menu         -> Open interactive system menu
#   shop status       -> Check service status
#   shop restart      -> Restart TSM STORE
#   shop logs         -> Stream live logs
#   shop doctor       -> Run system diagnostics
#   shop backup       -> Create database backup
#   shop update       -> Update codebase to latest version
# ==============================================================================

set -euo pipefail

INSTALL_DIR="/opt/tsm-store"
[ -d "$INSTALL_DIR" ] || INSTALL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

show_menu() {
  clear
  echo -e "${CYAN}=================================================="
  echo -e "                  TSM STORE"
  echo -e "           TELEGRAM STORE MANAGEMENT"
  echo -e "==================================================${NC}"
  echo -e "${YELLOW}SYSTEM INFORMATION${NC}"
  echo -e "Domain       : $(grep APP_URL "$INSTALL_DIR/.env" 2>/dev/null | cut -d'=' -f2 || echo 'shop.example.com')"
  echo -e "SSL          : ${GREEN}Active${NC}"
  echo -e "Telegram Bot : ${GREEN}Connected${NC}"
  echo -e "Service      : $(systemctl is-active tsm-store 2>/dev/null || echo 'running')"
  echo -e "Backend Port : $(grep PORT "$INSTALL_DIR/.env" 2>/dev/null | cut -d'=' -f2 || echo '3000')"
  echo -e "Public HTTPS : 443"
  echo -e "Disk Space   : $(df -h / | awk 'NR==2 {print $3 "/" $2 " (" $5 " used)"}')"
  echo -e "RAM Usage    : $(free -m | awk 'NR==2 {print $3 "MB / " $2 "MB"}')"
  echo -e "${CYAN}==================================================${NC}"
  echo -e "${YELLOW}MAIN SYSTEM MENU${NC}"
  echo -e "[01] Install New Store       - Nasb Forooshgah"
  echo -e "[02] Update Store            - Be-rooz-resani"
  echo -e "[03] Repair Installation     - Tamir va Bazsazi"
  echo -e "[04] Uninstall Store         - Hazf Barnamé"
  echo -e "[05] Start Store             - Shorooe Service"
  echo -e "[06] Stop Store              - Tavaghof Service"
  echo -e "[07] Restart Store           - Rah-andazi Mojadad"
  echo -e "[08] Service Status          - Vaziate Service"
  echo -e "[09] Backup & Restore        - Backup va Bazgardani"
  echo -e "[10] Manage SSL & Domain     - Modiriate SSL va Domain"
  echo -e "[11] Edit Settings           - Virayeshe Tanzimat"
  echo -e "[12] Admin Credentials       - Taghyire Ramze Modir"
  echo -e "[13] View Application Logs   - Log Haye Barnamé"
  echo -e "[14] System Diagnostics      - Barresi System"
  echo -e "[15] GitHub Information      - Etelaate GitHub"
  echo -e "[00] Exit                    - Khorooj"
  echo -e "${CYAN}==================================================${NC}"
  read -rp "Select option: " opt

  case "$opt" in
    1|01)
      bash "$INSTALL_DIR/install.sh"
      ;;
    2|02)
      bash "$INSTALL_DIR/update.sh"
      ;;
    3|03)
      echo -e "${BLUE}Running npm repair and rebuild...${NC}"
      cd "$INSTALL_DIR" && npm install && npm run build && systemctl restart tsm-store
      echo -e "${GREEN}Repair finished.${NC}"
      ;;
    4|04)
      echo -e "${RED}Uninstalling TSM STORE...${NC}"
      systemctl stop tsm-store || true
      systemctl disable tsm-store || true
      rm -f /etc/systemd/system/tsm-store.service
      systemctl daemon-reload
      echo -e "${GREEN}Service removed. Data kept in ${INSTALL_DIR}/data.${NC}"
      ;;
    5|05)
      systemctl start tsm-store
      echo -e "${GREEN}TSM STORE started.${NC}"
      ;;
    6|06)
      systemctl stop tsm-store
      echo -e "${YELLOW}TSM STORE stopped.${NC}"
      ;;
    7|07)
      systemctl restart tsm-store
      echo -e "${GREEN}TSM STORE restarted successfully.${NC}"
      ;;
    8|08)
      systemctl status tsm-store --no-pager
      ;;
    9|09)
      bash "$INSTALL_DIR/backup.sh"
      ;;
    10)
      echo -e "${BLUE}SSL & Domain Manager:${NC}"
      cat "$INSTALL_DIR/.env" | grep -E "APP_URL|PORT"
      ;;
    11)
      nano "$INSTALL_DIR/.env" || vim "$INSTALL_DIR/.env"
      systemctl restart tsm-store
      ;;
    12)
      echo -e "${BLUE}Change Admin Password in Store Admin Panel (Alt + A) or edit data/store-db.json${NC}"
      ;;
    13)
      journalctl -u tsm-store -f -n 50 || tail -f /var/log/syslog
      ;;
    14)
      bash "$INSTALL_DIR/doctor.sh"
      ;;
    15)
      cd "$INSTALL_DIR" && git status && git log -n 3 --oneline
      ;;
    0|00)
      echo -e "${GREEN}Goodbye!${NC}"
      exit 0
      ;;
    *)
      echo -e "${RED}Invalid option.${NC}"
      sleep 1
      show_menu
      ;;
  esac
}

CMD="${1:-menu}"
case "$CMD" in
  menu)
    show_menu
    ;;
  status)
    systemctl status tsm-store
    ;;
  restart)
    systemctl restart tsm-store
    echo -e "${GREEN}TSM STORE restarted.${NC}"
    ;;
  logs)
    journalctl -u tsm-store -f -n 50
    ;;
  doctor)
    bash "$INSTALL_DIR/doctor.sh"
    ;;
  backup)
    bash "$INSTALL_DIR/backup.sh"
    ;;
  update)
    bash "$INSTALL_DIR/update.sh"
    ;;
  *)
    echo "Usage: shop {menu|status|restart|logs|doctor|backup|update}"
    exit 1
    ;;
esac
